rules_version = '2';

// CasaFlow · reglas de seguridad de Firestore
// - El/la dueño/a de una casa (ownerUid) ve y edita todo lo de su casa.
// - Una colaboradora (invitada por email) solo ve/crea/edita SUS horas,
//   ve SUS pagos y su propia ficha. Nunca tarifas ni datos de otras personas.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }

    function invite() {
      return get(/databases/$(db)/documents/invites/$(myEmail()));
    }

    function hasInvite() {
      return myEmail() != '' && exists(/databases/$(db)/documents/invites/$(myEmail()));
    }

    function houseDoc(houseId) {
      return get(/databases/$(db)/documents/houses/$(houseId));
    }

    function isOwner(houseId) {
      return signedIn() && houseDoc(houseId).data.ownerUid == request.auth.uid;
    }

    function isMember(houseId) {
      return signedIn() && hasInvite() && invite().data.houseId == houseId;
    }

    function myStaffId() {
      return invite().data.staffId;
    }

    function validHours(data) {
      return data.hours is number && data.hours >= 0 && data.hours <= 24;
    }

    // ---- invitaciones: solo el dueño de ESA casa puede crearlas/cambiarlas;
    //      cada mail lee únicamente la suya.
    match /invites/{email} {
      allow read: if signedIn() && myEmail() == email;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.staffId is string
        && isOwner(request.resource.data.houseId);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && isOwner(request.resource.data.houseId);
      allow delete: if signedIn()
        && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // ---- casas
    match /houses/{houseId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isMember(houseId));
      allow update: if isOwner(houseId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(houseId);

      // ficha de cada persona: el dueño ve todas; una colaboradora solo la suya
      match /staff/{staffId} {
        allow read: if isOwner(houseId) || (isMember(houseId) && staffId == myStaffId());
        allow write: if isOwner(houseId);
      }

      // tarifas: solo el dueño
      match /rates/{staffId} {
        allow read, write: if isOwner(houseId);
      }

      // horas: una colaboradora solo puede crear/editar/borrar las suyas,
      // sin reasignarlas a otra persona ni pasar de 24 h
      match /entries/{entryId} {
        allow read: if isOwner(houseId)
          || (isMember(houseId) && resource.data.staffId == myStaffId());
        allow create: if isOwner(houseId)
          || (isMember(houseId)
              && request.resource.data.staffId == myStaffId()
              && validHours(request.resource.data));
        allow update: if isOwner(houseId)
          || (isMember(houseId)
              && resource.data.staffId == myStaffId()
              && request.resource.data.staffId == resource.data.staffId
              && validHours(request.resource.data));
        allow delete: if isOwner(houseId)
          || (isMember(houseId) && resource.data.staffId == myStaffId());
      }

      // pagos: el dueño los marca; cada colaboradora ve los suyos
      match /payments/{paymentId} {
        allow read: if isOwner(houseId)
          || (isMember(houseId) && resource.data.staffId == myStaffId());
        allow write: if isOwner(houseId);
      }
    }

    // =====================================================================
    // APP NUEVA (bloques) · colecciones separadas: hogares/ e invitaciones/
    // - La administración (ownerUid) ve y edita todo lo de su hogar.
    // - Una colaboradora ve su ficha, los meses, los bloques y la ocupación
    //   (reservas sin nombres: solo un id). Reserva SOLO a su nombre, en meses
    //   con reservas abiertas, con su permiso de titular o de shadow. Libera o
    //   cambia en meses cerrados solo con más de 24 h de anticipación.
    // =====================================================================

    function hogar(hid) {
      return get(/databases/$(db)/documents/hogares/$(hid));
    }

    function esAdmin(hid) {
      return signedIn() && hogar(hid).data.ownerUid == request.auth.uid;
    }

    function invitacion() {
      return get(/databases/$(db)/documents/invitaciones/$(myEmail()));
    }

    function tieneInvitacion() {
      return myEmail() != '' && exists(/databases/$(db)/documents/invitaciones/$(myEmail()));
    }

    function esMiembro(hid) {
      return signedIn() && tieneInvitacion() && invitacion().data.hid == hid;
    }

    function miSid() {
      return invitacion().data.staffId;
    }

    function mes(hid, ym) {
      return get(/databases/$(db)/documents/hogares/$(hid)/meses/$(ym));
    }

    // 8:00 y 13:00 de Argentina (UTC-3) = 11:00 y 16:00 UTC
    function inicioBloque(date, b) {
      let p = date.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(b == 'M' ? 11 : 16, 'h');
    }

    // Una persona no puede tener dos bloques el mismo día (se mira el estado DESPUÉS
    // de la escritura, así un cambio de mañana a tarde del mismo día sí se permite).
    function sinOtroBloqueEseDia(hid, date, b) {
      let otro = b == 'M' ? 'T' : 'M';
      let oT = /databases/$(db)/documents/hogares/$(hid)/reservas/$(date + '_' + otro + '_T');
      let oS = /databases/$(db)/documents/hogares/$(hid)/reservas/$(date + '_' + otro + '_S');
      return !(existsAfter(oT) && getAfter(oT).data.staffId == miSid())
        && !(existsAfter(oS) && getAfter(oS).data.staffId == miSid());
    }

    function reservaValida(hid, rid) {
      let d = request.resource.data;
      let m = mes(hid, d.month).data;
      let yo = get(/databases/$(db)/documents/hogares/$(hid)/equipo/$(miSid())).data;
      let bloque = /databases/$(db)/documents/hogares/$(hid)/bloques/$(d.date + '_' + d.b);
      let tit = /databases/$(db)/documents/hogares/$(hid)/reservas/$(d.date + '_' + d.b + '_T');
      let sh = /databases/$(db)/documents/hogares/$(hid)/reservas/$(d.date + '_' + d.b + '_S');
      let ant = /databases/$(db)/documents/hogares/$(hid)/reservas/$(d.get('movedFrom', '-'));
      let cerrado = exists(bloque) && get(bloque).data.get('closed', false) == true;
      let conShadow = exists(bloque) && get(bloque).data.get('shadow', false) == true;
      return d.keys().hasOnly(['date', 'b', 'role', 'staffId', 'month', 'startAt', 'createdAt', 'movedFrom'])
        && d.staffId == miSid()
        && d.month is string && d.date is string && d.date.matches(d.month + '-[0-9]{2}')
        && (d.b == 'M' || d.b == 'T')
        && d.startAt is timestamp
        && d.startAt == inicioBloque(d.date, d.b)
        && ((m.status == 'reservas' && d.startAt > request.time)
            || (m.status == 'cerrado' && d.startAt > request.time + duration.value(24, 'h')
                && get(ant).data.staffId == miSid() && get(ant).data.role == d.role
                && get(ant).data.month == d.month && !existsAfter(ant)))
        && yo.get('active', true) == true
        && !cerrado
        && sinOtroBloqueEseDia(hid, d.date, d.b)
        && ((d.role == 'titular' && rid == d.date + '_' + d.b + '_T' && yo.get('canTit', false) == true
              && !(exists(sh) && get(sh).data.staffId == miSid()))
          || (d.role == 'shadow' && rid == d.date + '_' + d.b + '_S' && yo.get('canSh', false) == true
              && conShadow && exists(tit) && get(tit).data.staffId != miSid()));
    }

    function esMiReserva(hid, date, b) {
      let t = /databases/$(db)/documents/hogares/$(hid)/reservas/$(date + '_' + b + '_T');
      let s = /databases/$(db)/documents/hogares/$(hid)/reservas/$(date + '_' + b + '_S');
      return (exists(t) && get(t).data.staffId == miSid())
        || (exists(s) && get(s).data.staffId == miSid());
    }

    // ---- invitaciones de la app nueva
    match /invitaciones/{email} {
      allow read: if signedIn()
        && (myEmail() == email || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.staffId is string
        && esAdmin(request.resource.data.hid);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && esAdmin(request.resource.data.hid);
      allow delete: if signedIn()
        && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // ---- hogares de la app nueva
    match /hogares/{hid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || esMiembro(hid));
      allow update: if esAdmin(hid)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if esAdmin(hid);

      // ficha: la administración ve todas; cada colaboradora solo la suya
      match /equipo/{sid} {
        allow read: if esAdmin(hid) || (esMiembro(hid) && sid == miSid());
        allow write: if esAdmin(hid);
      }

      // tarifas: la administración todas; cada colaboradora solo la suya (para su liquidación)
      match /tarifas/{sid} {
        allow read: if esAdmin(hid) || (esMiembro(hid) && sid == miSid());
        allow write: if esAdmin(hid);
      }

      // estado de cada mes y foto de turnos
      match /meses/{ym} {
        allow read: if esAdmin(hid) || esMiembro(hid);
        allow write: if esAdmin(hid);
      }

      // bloques cerrados y lugares de shadow
      match /bloques/{bid} {
        allow read: if esAdmin(hid) || esMiembro(hid);
        allow write: if esAdmin(hid);
      }

      // reservas: el id es fecha_bloque_T|S, así dos personas no pueden tomar el mismo lugar.
      // El presente (att) lo escribe solo la administración.
      match /reservas/{rid} {
        allow read: if esAdmin(hid) || esMiembro(hid);
        allow create: if esAdmin(hid) || (esMiembro(hid) && reservaValida(hid, rid));
        allow update: if esAdmin(hid);
        allow delete: if esAdmin(hid)
          || (esMiembro(hid) && resource.data.staffId == miSid()
              && (mes(hid, resource.data.month).data.status == 'reservas'
                  || resource.data.startAt > request.time + duration.value(24, 'h')));
      }

      // horas extra: la colaboradora pide (pendiente) sobre un bloque suyo; la administración aprueba
      match /extras/{eid} {
        allow read: if esAdmin(hid) || (esMiembro(hid) && resource.data.staffId == miSid());
        allow create: if esAdmin(hid)
          || (esMiembro(hid)
              && request.resource.data.keys().hasOnly(['date', 'b', 'staffId', 'h', 'motivo', 'by', 'estado', 'createdAt'])
              && request.resource.data.staffId == miSid()
              && request.resource.data.estado == 'pend'
              && request.resource.data.by == 'collab'
              && request.resource.data.h is number
              && request.resource.data.h > 0 && request.resource.data.h <= 6
              && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 80
              && esMiReserva(hid, request.resource.data.date, request.resource.data.b));
        allow update, delete: if esAdmin(hid);
      }

      // pases de turno: id = mes_persona. Ella solo puede pasar SU turno, en un mes con reservas abiertas.
      match /pases/{pid} {
        allow read: if esAdmin(hid) || esMiembro(hid);
        allow create: if esAdmin(hid)
          || (esMiembro(hid)
              && request.resource.data.keys().hasOnly(['month', 'staffId', 'at'])
              && request.resource.data.staffId == miSid()
              && request.resource.data.month is string
              && pid == request.resource.data.month + '_' + miSid()
              && mes(hid, request.resource.data.month).data.status == 'reservas');
        allow update, delete: if esAdmin(hid);
      }

      // pagos del mes: la administración los marca; cada colaboradora ve los suyos
      match /pagos/{pid} {
        allow read: if esAdmin(hid) || (esMiembro(hid) && resource.data.staffId == miSid());
        allow write: if esAdmin(hid);
      }
    }
  }
}
